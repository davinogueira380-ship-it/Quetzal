@model HomeViewModel
@{
    ViewData["Title"] = "Início";
}
@* <head>
    <link rel="stylesheet" href="~/css/site-publico.css">
</head> *@

<section id="inicio">
    <div class="container">
        <p>
            Transformar espaços vai muito além da estética. Acreditamos que cada ambiente deve refletir
            a essência, os hábitos e a personalidade de quem o utiliza. Por isso, desenvolvemos
            projetos de interiores personalizados, pensados para unir funcionalidade,
            conforto e identidade em cada detalhe.
        </p>
    </div>
</section>

<section id="ambientes">
    <div class="container">
        <h2>Ambientes</h2>

        @if (!Model.Ambientes.Any())
        {
            <p class="text-center">Em breve, novos ambientes por aqui.</p>
        }
        else
        {
            <div class="row gy-4 Galeria">
                @foreach (var ambiente in Model.Ambientes)
                {
                    <div class="col-12 col-lg-6">
                        <a asp-controller="Portfolio" asp-action="Ambiente" asp-route-ambienteId="@ambiente.Id">
                            @if (!string.IsNullOrWhiteSpace(ambiente.ImagemUpload))
                            {
                                <img class="img-fluid" src="@ambiente.ImagemUpload" alt="@ambiente.Nome">
                            }
                                else
                                {
                                    <div class="imagem-placeholder">
                                     <span class="icone">🖼️</span>
                                     <span class="texto">Foto em breve</span>
                                    </div>
                                }
                                <span>@ambiente.Nome</span>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

