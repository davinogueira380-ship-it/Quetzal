@model Quetzal.UI.Models.ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}

<div class="pagina-erro">
    <div class="container text-center py-5">
        <h1>Algo deu errado</h1>
        <p>Não conseguimos processar sua solicitação. Já estamos cientes do problema.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted">
                <small>Código da ocorrência: <code>@Model.RequestId</code></small>
            </p>
        }

        <a asp-area="" asp-controller="Home" asp-action="Index" class="btnDefault">
            Voltar para a Home
        </a>
    </div>
</div>