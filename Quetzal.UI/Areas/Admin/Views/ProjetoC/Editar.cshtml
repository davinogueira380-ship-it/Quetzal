@model ProjetoCEdicaoViewModel
@{
    ViewData["Title"] = "Editar Projeto";
}

<div class="admin-topbar">
    <h1>Editar Projeto</h1>
</div>

<div class="admin-form-wrapper">
    <div asp-validation-summary="ModelOnly" class="admin-alerta admin-alerta-erro"></div>

    <div class="mb-3">
        <label>Cliente</label>
        <input type="text" class="form-control" value="@Model.ClienteNome" readonly disabled>
    </div>

    <form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImagemAtualUrl" />

        <div class="mb-3">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Ambientes</label>
            <div class="checkbox-ambientes">
                @foreach (var ambiente in Model.AmbientesDisponiveis)
                {
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               name="AmbientesSelecionadosIds"
                               value="@ambiente.Value"
                               id="ambiente_@ambiente.Value"
                               checked="@ambiente.Selected" />
                        <label class="form-check-label" for="ambiente_@ambiente.Value">@ambiente.Text</label>
                    </div>
                }
            </div>
            <span asp-validation-for="AmbientesSelecionadosIds" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImagemArquivo"></label>
            <input asp-for="ImagemArquivo" class="form-control" type="file" accept="image/*" />

            @if (!string.IsNullOrWhiteSpace(Model.ImagemAtualUrl))
            {
                <p class="mt-2 mb-1"><small>Imagem atual:</small></p>
                <img src="@Model.ImagemAtualUrl" alt="Imagem atual" class="imagem-preview">
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-admin-primario">
                <i class="fa-solid fa-check"></i> Salvar
            </button>
            <a asp-action="Index" class="btn-admin-secundario">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
